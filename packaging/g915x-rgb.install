post_install() {
  cat <<'EOF'
Reconnect the keyboard so the new device rule applies, then run as your user:
  systemctl --user daemon-reload
  systemctl --user enable --now g915x-rgb.service
Typing effects are optional; see /usr/share/doc/g915x-rgb/README.md
EOF
}

post_upgrade() {
  echo "To use the new version now: systemctl --user restart g915x-rgb.service"
}
