[Unit]
Description=G915 X RGB - keyboard daemon (renderer + auto-switch + reactive)
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/bash -c 'PYTHONPATH=/home/joshua/Development/g915x-rgb/src /usr/bin/python3 -m g915x_rgb.daemon'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
